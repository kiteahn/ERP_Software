<Window x:Class="PhanMemInAnERP.Views.AuditLogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="NHẬT KÝ HỆ THỐNG" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding TuNgay}" Width="130" Margin="0,0,20,0"/>

            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding DenNgay}" Width="130" Margin="0,0,20,0"/>

            <TextBlock Text="Hành động:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding CacHanhDong}"
                     SelectedItem="{Binding FilterHanhDong}"
                     Width="130" Margin="0,0,20,0"/>

            <TextBlock Text="Người dùng:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding DanhSachUser}"
                     SelectedItem="{Binding FilterUser}"
                     Width="150" Margin="0,0,20,0"
                     IsEditable="True"/>

            <Button Content="Tìm kiếm"
                    Command="{Binding TimKiemCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding DanhSachLog}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian"
                                    Binding="{Binding ThoiGian, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                                    Width="160"/>
                <DataGridTextColumn Header="Người dùng"
                                    Binding="{Binding NguoiThucHien}"
                                    Width="140"/>
                <DataGridTextColumn Header="Vai trò"
                                    Binding="{Binding User.Role}"
                                    Width="100"/>
                <DataGridTemplateColumn Header="Hành động" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6,2" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="CREATE">
                                                <Setter Property="Background" Value="#c8e6c9"/>
                                                <Setter Property="TextElement.Foreground" Value="#2e7d32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="UPDATE">
                                                <Setter Property="Background" Value="#fff9c4"/>
                                                <Setter Property="TextElement.Foreground" Value="#f57f17"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="DELETE">
                                                <Setter Property="Background" Value="#ffcdd2"/>
                                                <Setter Property="TextElement.Foreground" Value="#c62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="LOGIN">
                                                <Setter Property="Background" Value="#eceff1"/>
                                                <Setter Property="TextElement.Foreground" Value="#546e7a"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="LOGOUT">
                                                <Setter Property="Background" Value="#eceff1"/>
                                                <Setter Property="TextElement.Foreground" Value="#546e7a"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="KETCUYEN">
                                                <Setter Property="Background" Value="#e1bee7"/>
                                                <Setter Property="TextElement.Foreground" Value="#7b1fa2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HanhDong}" Value="EXPORT">
                                                <Setter Property="Background" Value="#ffe0b2"/>
                                                <Setter Property="TextElement.Foreground" Value="#e65100"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding HanhDong}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Bảng"
                                    Binding="{Binding TenBang}"
                                    Width="150"/>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding IdBanGhi}"
                                    Width="60"/>
                <DataGridTextColumn Header="Mô tả"
                                    Binding="{Binding DuLieuMoi}"
                                    Width="*"/>
                <DataGridTextColumn Header="IP"
                                    Binding="{Binding DiaChiIP}"
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Pagination & Actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Pagination -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="◀"
                        Command="{Binding TrangTruocCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="40"/>
                <TextBlock VerticalAlignment="Center" Margin="8,0">
                    <Run Text="Trang "/>
                    <Run Text="{Binding TrangHienTai}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TongTrang}"/>
                </TextBlock>
                <Button Content="▶"
                        Command="{Binding TrangSauCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="40"/>
                <TextBlock Text="{Binding TongSoBanGhi, StringFormat='{}{0} bản ghi'}"
                           VerticalAlignment="Center"
                           Foreground="#888"
                           Margin="20,0,0,0"/>
            </StackPanel>

            <!-- Export -->
            <Button Grid.Column="1"
                    Content="Xuất Excel"
                    Command="{Binding XuatExcelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </Grid>
    </Grid>
</Window>
