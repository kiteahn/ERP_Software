<Window x:Class="PhanMemInAnERP.Views.BankTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển khoản" Height="640" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="🏦 Thanh toán chuyển khoản" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" Foreground="#0d47a1"/>

                <Border Background="White" CornerRadius="8" Padding="12" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <Image x:Name="QrImage" MaxHeight="320" Stretch="Uniform" Visibility="Collapsed"/>
                        <TextBlock x:Name="QrMissingHint" TextWrapping="Wrap" Foreground="#856404" Background="#fff3cd" Padding="10" Margin="0,0,0,8"
                                   Text="Chưa tìm thấy ảnh QR. Hãy đặt file QR_CK.jpg vào thư mục Assets trong thư mục chương trình." Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,12,0,0" BorderBrush="#dee2e6" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Số tài khoản" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtAccount" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Ngân hàng" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtBank" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Chủ tài khoản" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtHolder" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="Nội dung chuyển khoản" FontWeight="Bold" Foreground="#495057" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtContent" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48"
                                 Padding="8" FontSize="14" Background="#f8f9fa" BorderBrush="#ced4da"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,16,0,0">
            <Button Content="✅ Đã chuyển khoản" Height="42" FontWeight="Bold" Background="#28a745" Foreground="White"
                    Click="Confirm_Click" Margin="0,0,0,8"/>
            <Button Content="⏸ Chưa chuyển khoản" Height="40" FontWeight="Bold" Background="#6c757d" Foreground="White"
                    Click="NotYet_Click"/>
        </StackPanel>
    </Grid>
</Window>
