<Window x:Class="PhanMemInAnERP.Views.AdminUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhanMemInAnERP.ViewModels"
        Title="Quản Lý Tài Khoản" Height="700" Width="1100" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:AdminUserViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Thông Tin Tài Khoản" Foreground="#17a2b8" FontWeight="Bold" Margin="0,0,15,0">
                    <StackPanel Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">

                        <TextBlock Text="Tên Đầy Đủ:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CurrentUser.FullName}" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Email liên hệ:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CurrentUser.Email}" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Số điện thoại:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CurrentUser.PhoneNumber}" Margin="0,5,0,15" Padding="5"/>

                        <TextBlock Text="Tên Đăng Nhập (*):" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox Text="{Binding CurrentUser.Username}" Margin="0,5,0,15" Padding="5" Background="#f8f9fa"/>

                        <TextBlock Text="Mật khẩu:" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CurrentUser.Password}" Margin="0,5,0,15" Padding="5" ToolTip="Để trống khi tạo mới sẽ mặc định là 123456"/>

                        <TextBlock Text="Phân Quyền (Role) (*):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#dc3545"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding CurrentUser.Role}" Margin="0,5,0,12" Padding="5"/>

                        <Border Background="#f0f7ff" BorderBrush="#b8d4f0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="📋 Thu tiền (tài khoản đang chọn)" FontWeight="SemiBold" Foreground="#1565c0" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Số phiếu thu:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentUser.PaymentReceiptCount, Mode=OneWay}"
                                             IsReadOnly="True" Background="#e3f2fd" BorderThickness="1" Padding="6,4" Margin="8,0,0,6"
                                             VerticalContentAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Tổng đã thu:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentUser.PaymentTotalAmount, Mode=OneWay, StringFormat={}{0:N0} đ}"
                                             IsReadOnly="True" Background="#e8f5e9" BorderThickness="1" Padding="6,4" Margin="8,0,0,0"
                                             VerticalContentAlignment="Center" FontWeight="Bold" Foreground="#2e7d32"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="💾 LƯU TÀI KHOẢN" Command="{Binding SaveCommand}" Background="#17a2b8" Foreground="White" FontWeight="Bold" Width="150" Padding="8" Margin="0,0,10,0"/>
                            <Button Content="🔄 Làm Mới" Command="{Binding ClearCommand}" Background="#6c757d" Foreground="White" Width="100" Padding="8"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Danh Sách Nhân Viên" Foreground="#28a745" FontWeight="Bold">
                    <DataGrid Margin="5" ItemsSource="{Binding UsersList}" SelectedItem="{Binding CurrentUser, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#f8f9fa">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mật Khẩu" Binding="{Binding Password}"/>
                            <DataGridTextColumn Header="Quyền (Role)" Binding="{Binding Role}" Foreground="#dc3545" FontWeight="Bold"/>

                            <DataGridTemplateColumn Header="Xóa" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#dc3545" Foreground="White" BorderThickness="0" Padding="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
</Window>
