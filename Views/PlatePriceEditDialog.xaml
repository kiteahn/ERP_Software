<Window x:Class="PhanMemInAnERP.Views.PlatePriceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa giá kẽm / màu"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Padding="16" MinWidth="360">
        <StackPanel>
            <TextBlock Text="Đơn giá kẽm cho 1 màu (VNĐ) — dùng làm mặc định khi mở báo giá mới." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="Máy in lớn:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtLarge" Padding="6" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
            <TextBlock Text="Máy in nhỏ:" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtSmall" Padding="6" Margin="0,0,0,16" VerticalContentAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="88" Margin="0,0,8,0" Padding="8,6" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Lưu" Width="88" Padding="8,6" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
