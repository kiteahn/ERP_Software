<Window x:Class="PhanMemInAnERP.Views.KeToanView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="KẾ TOÁN &amp; SỔ SÁCH" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <TabControl>
            <!-- TAB 1: SỔ CÁI -->
            <TabItem Header="Sổ Cái">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Tài khoản:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="300"
                                  ItemsSource="{Binding DanhSachTK}"
                                  SelectedItem="{Binding TKChon}"
                                  DisplayMemberPath="MaTK"
                                  Margin="0,0,20,0"/>
                        <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding TuNgay_SoCai}" Width="130" Margin="0,0,20,0"/>
                        <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding DenNgay_SoCai}" Width="130" Margin="0,0,20,0"/>
                        <Button Content="Xem Sổ Cái"
                                Command="{Binding XemSoCaiCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>

                    <!-- Metric Cards -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư đầu kỳ" Foreground="#888" FontSize="12"/>
                                <TextBlock Text="{Binding SoDuDauKy, StringFormat='{}{0:N0} đ'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#333"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Phát sinh Nợ" Foreground="#c62828" FontSize="12"/>
                                <TextBlock Text="{Binding PhatSinhNo, StringFormat='{}{0:N0} đ'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#c62828"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Phát sinh Có" Foreground="#1565c0" FontSize="12"/>
                                <TextBlock Text="{Binding PhatSinhCo, StringFormat='{}{0:N0} đ'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#1565c0"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="12" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư cuối kỳ" Foreground="#2e7d32" FontSize="12"/>
                                <TextBlock Text="{Binding SoDuCuoiKy, StringFormat='{}{0:N0} đ'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#2e7d32"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DanhSachSoCai}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày HT"
                                                Binding="{Binding NgayHachToan, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Số CT" Binding="{Binding SoChungTu}" Width="100"/>
                            <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="*"/>
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding DoiTuong}" Width="120"/>
                            <DataGridTemplateColumn Header="Nợ" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SoTienNo, StringFormat='{}{0:N0}'}"
                                                   Foreground="#c62828"
                                                   TextAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Có" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SoTienCo, StringFormat='{}{0:N0}'}"
                                                   Foreground="#1565c0"
                                                   TextAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Xuất Excel Sổ Cái"
                                Command="{Binding XuatExcelSoCaiCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: CÂN ĐỐI SỐ PHÁT SINH -->
            <TabItem Header="Cân Đối Số Phát Sinh">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding TuNgay_CanDoi}" Width="130" Margin="0,0,20,0"/>
                        <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding DenNgay_CanDoi}" Width="130" Margin="0,0,20,0"/>
                        <Button Content="Tải lại"
                                Command="{Binding TaiLaiCanDoiCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,12,0"/>
                        <Button Content="Xuất Excel"
                                Command="{Binding XuatExcelCanDoiCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>

                    <!-- Summary -->
                    <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư ĐK Nợ" FontSize="10" Foreground="#888"/>
                                <TextBlock Text="{Binding TongDuDauNo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư ĐK Có" FontSize="10" Foreground="#888"/>
                                <TextBlock Text="{Binding TongDuDauCo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="PS Nợ" FontSize="10" Foreground="#c62828"/>
                                <TextBlock Text="{Binding TongPsNo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold" Foreground="#c62828"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="PS Có" FontSize="10" Foreground="#1565c0"/>
                                <TextBlock Text="{Binding TongPsCo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold" Foreground="#1565c0"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư CK Nợ" FontSize="10" Foreground="#888"/>
                                <TextBlock Text="{Binding TongDuCuoiNo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="8" Margin="2" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Dư CK Có" FontSize="10" Foreground="#888"/>
                                <TextBlock Text="{Binding TongDuCuoiCo, StringFormat='{}{0:N0}'}" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding DanhSachCanDoi}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số TK" Binding="{Binding MaTK}" Width="80"/>
                            <DataGridTextColumn Header="Tên TK" Binding="{Binding TenTK}" Width="*"/>
                            <DataGridTextColumn Header="Dư ĐK Nợ" Binding="{Binding DuDauKyNo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dư ĐK Có" Binding="{Binding DuDauKyCo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PS Nợ" Binding="{Binding PhatSinhNo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#c62828"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PS Có" Binding="{Binding PhatSinhCo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#1565c0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dư CK Nợ" Binding="{Binding DuCuoiKyNo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dư CK Có" Binding="{Binding DuCuoiKyCo, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: KẾT CHUYỂN CUỐI KỲ -->
            <TabItem Header="Kết Chuyển Cuối Kỳ">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Date Selection -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Kỳ bắt đầu:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding KyBatDau}" Width="130" Margin="0,0,20,0"/>
                        <TextBlock Text="Kỳ kết thúc:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding KyKetThuc}" Width="130" Margin="0,0,20,0"/>
                        <Button Content="Xem trước bút toán"
                                Command="{Binding XemTruocCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,12,0"/>
                    </StackPanel>

                    <!-- Preview Warning -->
                    <Border Grid.Row="1"
                            Background="#fff3e0"
                            BorderBrush="#ff9800"
                            BorderThickness="1"
                            Padding="12"
                            Margin="0,0,0,12"
                            Visibility="{Binding DaXemTruoc, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="⚠️ Đây là xem trước. Chưa lưu vào sổ. Nhấn 'Thực hiện kết chuyển' để ghi nhận."
                                   Foreground="#e65100"/>
                    </Border>

                    <!-- Result -->
                    <Border Grid.Row="2"
                            Background="#e8f5e9"
                            BorderBrush="#4caf50"
                            BorderThickness="2"
                            Padding="16"
                            Margin="0,0,0,12"
                            Visibility="{Binding KetQuaKetChuyen, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding KetQuaKetChuyen}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2e7d32"/>
                    </Border>

                    <!-- Preview Grid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding DanhSachXemTruoc}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Visibility="{Binding DaXemTruoc, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TK Nợ" Binding="{Binding TKNo}" Width="80"/>
                            <DataGridTextColumn Header="Tên TK Nợ" Binding="{Binding TenTKNo}" Width="*"/>
                            <DataGridTextColumn Header="TK Có" Binding="{Binding TKCo}" Width="80"/>
                            <DataGridTextColumn Header="Tên TK Có" Binding="{Binding TenTKCo}" Width="*"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTien, StringFormat='{}{0:N0}'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Diễn giải" Binding="{Binding DienGiai}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Execute Button -->
                    <Button Grid.Row="3"
                            Content="Thực hiện kết chuyển"
                            Command="{Binding KetChuyenCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,16,16"
                            Padding="24,12"
                            Style="{StaticResource MaterialDesignRaisedAccentButton}"
                            Visibility="{Binding DaXemTruoc, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </TabItem>

            <!-- TAB 4: BÁO CÁO DOANH THU -->
            <TabItem Header="Báo Cáo Doanh Thu">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding TuNgay_BaoCao}" Width="130" Margin="0,0,20,0"/>
                        <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding DenNgay_BaoCao}" Width="130" Margin="0,0,20,0"/>
                        <Button Content="Xem Báo Cáo"
                                Command="{Binding XemBaoCaoCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,12,0"/>
                        <Button Content="Xuất Excel"
                                Command="{Binding XuatExcelBaoCaoCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>

                    <!-- KPI Cards -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Doanh thu thuần" Foreground="#1565c0" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.DoanhThuThuan, StringFormat='{}{0:N0} đ'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#1565c0"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Tăng trưởng" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.TyLeTangTruong, StringFormat='{}{0:F1}%'}"
                                           FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Giá vốn" Foreground="#ff6f00" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.GiaVon, StringFormat='{}{0:N0} đ'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#ff6f00"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Lợi nhuận gộp" Foreground="#2e7d32" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.LoiNhuanGop, StringFormat='{}{0:N0} đ'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#2e7d32"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Tỷ lệ LN gộp" Foreground="#2e7d32" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.TyLeLoiNhuanGop, StringFormat='{}{0:F1}%'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#2e7d32"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="16" Margin="4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="LN thuần trước thuế" FontSize="12"/>
                                <TextBlock Text="{Binding BaoCao.LoiNhuanThuanTruocThue, StringFormat='{}{0:N0} đ'}"
                                           FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Chi tiết TK 511 -->
                    <TextBlock Grid.Row="2" Text="Chi tiết TK 511 — Doanh thu theo loại"
                               FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ChiTiet511}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã TK" Binding="{Binding MaTK}" Width="80"/>
                            <DataGridTextColumn Header="Tên TK" Binding="{Binding TenTK}" Width="*"/>
                            <DataGridTextColumn Header="Doanh thu" Binding="{Binding TongDoanhThu, StringFormat='{}{0:N0}'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Tỷ trọng" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Value="{Binding TyTrong}"
                                                         Maximum="100"
                                                         Height="16"/>
                                            <TextBlock Text="{Binding TyTrong, StringFormat='{}{0:F1}%'}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
