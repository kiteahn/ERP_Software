<Window x:Class="PhanMemInAnERP.Views.PartialPaymentInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập số tiền thu (một phần)" Height="Auto" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height"
        Background="#f8f9fa">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Foreground="#1565c0" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="Nhập số tiền khách trả cho hóa đơn (có thể nhỏ hơn tổng nợ). Ví dụ: hóa đơn 10.000.000 đ, khách trả 5.000.000 đ."/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Công nợ hiện tại (tối đa có thể thu):" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtMaxDebt" FontSize="20" FontWeight="Bold" Foreground="#c62828"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="Số tiền thu:" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAmount" FontSize="20" Padding="10" FontWeight="Bold" Foreground="#0d47a1"
                     ToolTip="Chỉ số, có thể dùng dấu chấm phân cách hàng nghìn (vd: 5000000 hoặc 5.000.000)"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Width="100" Margin="0,0,10,0" Padding="10,8" Click="BtnCancel_Click" IsCancel="True"/>
            <Button Content="Xác nhận" Width="120" Padding="10,8" FontWeight="Bold" Background="#28a745" Foreground="White" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
