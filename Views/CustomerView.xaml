<Window x:Class="PhanMemInAnERP.Views.CustomerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="vi-VN"
        Title="Quản Lý Khách Hàng" Height="680" Width="1180" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Danh sách khách hàng" 
                   FontSize="14" Foreground="#555" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" MinWidth="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Thông Tin Khách Hàng" Foreground="#e65100" FontWeight="Bold" Margin="0,0,15,0">
                <StackPanel Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">

                    <TextBlock Text="Tên Khách Hàng (*):" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CurrentCustomer.Name}" Margin="0,5,0,15" Padding="5"/>

                    <TextBlock Text="Số Điện Thoại:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CurrentCustomer.Phone}" Margin="0,5,0,15" Padding="5"/>

                    <TextBlock Text="Địa Chỉ:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CurrentCustomer.Address}" Margin="0,5,0,15" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                    <TextBlock Text="Mã Số Thuế:" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CurrentCustomer.TaxCode}" Margin="0,5,0,10" Padding="5"/>

                    <StackPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tổng đơn hàng đã đặt: " Foreground="#1565c0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCustomer.SalesOrderCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="#0d47a1" VerticalAlignment="Center"/>
                            <TextBlock Text=" đơn" Foreground="#1565c0" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tổng tiền: " Foreground="#e65100" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentCustomer.SalesOrderTotal, Mode=OneWay, StringFormat={}{0:N0}}"
                                       FontSize="18" FontWeight="Bold" Foreground="#bf360c"
                                       TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text=" đ" Foreground="#e65100" FontWeight="SemiBold" VerticalAlignment="Top" Margin="4,2,0,0"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="(Theo đơn hàng trùng tên khách trong hệ thống)" FontSize="11" Foreground="#78909c" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="💾 LƯU KHÁCH HÀNG" Command="{Binding SaveCustomerCommand}" Background="#e65100" Foreground="White" FontWeight="Bold" Width="160" Padding="8" Margin="0,0,10,0"/>
                        <Button Content="🔄 Làm Mới" Command="{Binding ClearCustomerCommand}" Background="#6c757d" Foreground="White" Width="100" Padding="8"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Danh Sách Khách Hàng" Foreground="#28a745" FontWeight="Bold">
                <DataGrid Margin="5" ItemsSource="{Binding CustomersList}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#f8f9fa">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên Khách Hàng" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Mã Số Thuế" Binding="{Binding TaxCode}" Width="150"/>

                        <DataGridTemplateColumn Header="Xóa" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#dc3545" Foreground="White" BorderThickness="0" Padding="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
