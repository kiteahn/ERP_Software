<Window x:Class="PhanMemInAnERP.Views.CongNoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CÔNG NỢ PHẢI THU" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <Border BorderBrush="#1565c0" BorderThickness="2" Padding="16" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Tổng phải thu" Foreground="#1565c0" FontSize="12"/>
                    <TextBlock Text="{Binding TongPhaiThu, StringFormat='{}{0:N0} đ'}"
                               FontSize="20" FontWeight="Bold" Foreground="#1565c0"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#2e7d32" BorderThickness="2" Padding="16" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Đã thu" Foreground="#2e7d32" FontSize="12"/>
                    <TextBlock Text="{Binding TongDaThu, StringFormat='{}{0:N0} đ'}"
                               FontSize="20" FontWeight="Bold" Foreground="#2e7d32"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#ff6f00" BorderThickness="2" Padding="16" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Còn lại" Foreground="#ff6f00" FontSize="12"/>
                    <TextBlock Text="{Binding TongConLai, StringFormat='{}{0:N0} đ'}"
                               FontSize="20" FontWeight="Bold" Foreground="#ff6f00"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="#c62828" BorderThickness="2" Padding="16" Margin="4" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Quá hạn" Foreground="#c62828" FontSize="12"/>
                    <TextBlock Text="{Binding TongQuaHan, StringFormat='{}{0:N0} đ'}"
                               FontSize="20" FontWeight="Bold" Foreground="#c62828"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding CacTrangThai}"
                     SelectedItem="{Binding FilterTrangThai}"
                     Width="180" Margin="0,0,16,0"/>
            <Button Content="Tải lại"
                    Command="{Binding TaiLaiCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding DanhSachCongNo}"
                  SelectedItem="{Binding CongNoDangChon}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã KH"
                                   Binding="{Binding Customer.MaKH}"
                                   Width="90"/>
                <DataGridTextColumn Header="Tên khách hàng"
                                   Binding="{Binding Customer.Name}"
                                   Width="180"/>
                <DataGridTextColumn Header="Số HĐ"
                                   Binding="{Binding Invoice.InvoiceNo}"
                                   Width="100"/>
                <DataGridTextColumn Header="Ngày HĐ"
                                   Binding="{Binding NgayHoaDon, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   Width="90"/>
                <DataGridTextColumn Header="Ngày đến hạn"
                                   Binding="{Binding NgayDenHan, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   Width="100"/>
                <DataGridTextColumn Header="Phải thu"
                                   Binding="{Binding SoTienPhaiThu, StringFormat='{}{0:N0}'}"
                                   Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Đã thu"
                                   Binding="{Binding SoTienDaThu, StringFormat='{}{0:N0}'}"
                                   Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="#2e7d32"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Còn lại"
                                   Binding="{Binding SoTienConLai, StringFormat='{}{0:N0}'}"
                                   Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Số ngày QH"
                                   Binding="{Binding SoNgayQuaHan}"
                                   Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SoNgayQuaHan, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                    <Setter Property="Foreground" Value="#c62828"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Trạng thái" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="Đã thanh toán">
                                                <Setter Property="Background" Value="#c8e6c9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="Quá hạn">
                                                <Setter Property="Background" Value="#ffcdd2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="Thanh toán một phần">
                                                <Setter Property="Background" Value="#fff9c4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TrangThai}" Value="Chưa thanh toán">
                                                <Setter Property="Background" Value="#e3f2fd"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TrangThai}" FontWeight="Medium" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Thu tiền panel -->
        <Border Grid.Row="3" Background="#f5f5f5" Padding="16" Margin="0,12,0,0" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Thu tiền từ khách hàng đang chọn:" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>

                <TextBlock Text="Số tiền:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SoTienThu, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                        Width="150" Margin="0,0,16,0"
                        materialDesign:HintAssist.Hint="0"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBlock Text="Hình thức:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding CacHinhThucThu}"
                         SelectedItem="{Binding HinhThucThu}"
                         Width="140" Margin="0,0,16,0"/>

                <Button Content="Xác nhận thu"
                        Command="{Binding GhiNhanThanhToanCommand}"
                        Style="{StaticResource MaterialDesignRaisedAccentButton}"
                        Margin="0,0,16,0"/>

                <Button Content="Xuất Excel công nợ"
                        Command="{Binding XuatExcelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
