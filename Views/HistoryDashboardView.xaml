<Window x:Class="PhanMemInAnERP.Views.HistoryDashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhanMemInAnERP.ViewModels"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Lịch Sử &amp; Dashboard" Height="800" Width="1400" WindowStartupLocation="CenterScreen" Background="#f4f6f9">

    <Window.DataContext>
        <vm:HistoryDashboardViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <TabControl Background="Transparent" BorderThickness="0">

            <TabItem Header="📈 TỔNG QUAN DASHBOARD" FontSize="16" FontWeight="Bold">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <UniformGrid Columns="4" Height="130" Margin="0,0,0,20">
                            <Border Background="#667eea" CornerRadius="10" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="TỔNG BÁO GIÁ (theo lọc)" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TotalQuotes}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#28a745" CornerRadius="10" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="SẢN LƯỢNG — theo lọc (Cái)" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TotalProducts, StringFormat={}{0:N0}}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#f2994a" CornerRadius="10" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="TỔNG DOANH THU (theo lọc)" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding EstimatedRevenue, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#dc3545" CornerRadius="10" Margin="10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="TB ĐƠN (theo lọc)" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AverageOrderValue, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="350"/>
                                <RowDefinition Height="400"/>
                                <RowDefinition Height="400"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== BỘ LỌC THEO NHÂN VIÊN ===== -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="#f8f9fa" CornerRadius="5" Padding="12,10" Margin="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,16,0" Padding="4"/>
                                        <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,20,0" Padding="4"/>
                                        <ComboBox Width="220" Height="32" MinHeight="28"
                                                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding AvailableCustomerNames}"
                                                  SelectedItem="{Binding SelectedCustomerFilter}"
                                                  Padding="6,2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Toàn hệ thống (không lọc ngày/KH) — Tổng báo giá:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0" Foreground="#555"/>
                                        <TextBlock Text="{Binding TotalQuotesAllTime}" FontSize="16" FontWeight="Bold" Foreground="#667eea" VerticalAlignment="Center"/>
                                        <TextBlock Text=" | Doanh thu:" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#555"/>
                                        <TextBlock Text="{Binding TotalRevenueAllTime, StringFormat={}{0:N0} đ}" FontSize="16" FontWeight="Bold" Foreground="#28a745" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="1. Doanh thu theo ngày" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:CartesianChart Series="{Binding BarSeries}" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding BarLabels}"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding Formatter}" Title="VNĐ"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Grid.Column="2" Header="2. Sản lượng chốt" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:CartesianChart Series="{Binding LineSeries}" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding LineLabels}"/>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                            </GroupBox>

                            <!-- ===== BIỂU ĐỒ THEO THÁNG (MỚI) ===== -->
                            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="📅 BIỂU ĐỒ THEO THÁNG - Số Báo Giá &amp; Doanh Thu" Margin="10" FontWeight="Bold" Foreground="#2e7d32">
                                <lvc:CartesianChart Series="{Binding MonthlyQuoteSeries}" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding MonthlyQuoteLabels}" Title="Tháng"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis MinValue="0" Title="Số báo giá"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </GroupBox>

                            <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Header="3. Tương quan Giá Vốn - Lợi Nhuận" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:CartesianChart Series="{Binding AreaSeries}" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding AreaLabels}"/>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                            </GroupBox>

                            <GroupBox Grid.Row="3" Grid.Column="2" Header="4. Số lượng vs Doanh thu theo ngày" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:CartesianChart Series="{Binding StackedSeries}" Margin="10">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding StackedLabels}"/>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                            </GroupBox>

                            <GroupBox Grid.Row="4" Grid.Column="0" Header="5. Phân bổ Loại Máy In" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:PieChart Series="{Binding PieSeries}" LegendLocation="Bottom" Margin="10"/>
                            </GroupBox>

                            <GroupBox Grid.Row="4" Grid.Column="1" Header="6. Top 5 Khách Hàng (doanh thu)" Margin="10" FontWeight="Bold" Foreground="#333">
                                <lvc:CartesianChart Series="{Binding KpiSeries}" Margin="10" MinHeight="280"
                                                    DisableAnimations="True" ScrollMode="None">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Labels="{Binding KpiLabels}" FontSize="11" Foreground="#555"
                                                  ShowLabels="True" Position="LeftBottom">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator Step="1" IsEnabled="True"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis MinValue="0" LabelFormatter="{Binding KpiAxisFormatter}" Title="Triệu VNĐ"
                                                  FontSize="11" Foreground="#555">
                                            <lvc:Axis.Separator>
                                                <lvc:Separator IsEnabled="True"/>
                                            </lvc:Axis.Separator>
                                        </lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                </lvc:CartesianChart>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📋 LỊCH SỬ BÁO GIÁ" FontSize="16" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Bộ Lọc Tìm Kiếm" Margin="0,0,0,15" FontWeight="Bold" Foreground="#17a2b8">
                        <StackPanel Margin="10" TextElement.FontWeight="Normal" TextElement.Foreground="Black">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding FromDate}" Width="150" Margin="0,0,20,0" Padding="5"/>

                                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <DatePicker SelectedDate="{Binding ToDate}" Width="150" Margin="0,0,20,0" Padding="5"/>

                                <TextBlock Text="Khách hàng:" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,10,0"/>
                                <ComboBox Width="240" MinHeight="28" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding AvailableCustomerNames}"
                                          SelectedItem="{Binding SelectedCustomerFilter}"
                                          Padding="6,2"/>

                                <Button Content="🔍 Lọc Dữ Liệu" Command="{Binding FilterCommand}" Background="#17a2b8" Foreground="White" Padding="15,5" FontWeight="Bold" Cursor="Hand" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding QuoteHistory}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" AlternatingRowBackground="#f8f9fa" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày Báo" Binding="{Binding QuoteDate, StringFormat=dd/MM/yyyy HH:mm}"/>
                            <DataGridTextColumn Header="Khách Hàng" Binding="{Binding CustomerName}" Width="*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Sản Phẩm" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding Quantity, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="Đơn Giá" Binding="{Binding QuotedUnitPrice, StringFormat={}{0:N0} đ}" Foreground="Blue"/>
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalOrderValue, StringFormat={}{0:N0} VNĐ}" FontWeight="Bold" Foreground="#155724"/>

                            <DataGridTemplateColumn Header="Thao Tác" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="🛒 Giao dịch" 
                                                    Command="{Binding DataContext.CreateOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#28a745" Foreground="White" Padding="12,4" Margin="0,0,8,0"
                                                    ToolTip="Chuyển báo giá này sang Đơn Hàng &amp; Công Nợ" FontWeight="Bold" Cursor="Hand"/>

                                            <Button Content="👁️ Tải lại" 
                                                    Command="{Binding DataContext.LoadQuoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#17a2b8" Foreground="White" Padding="8,4" Margin="0,0,8,0"
                                                    ToolTip="Load dữ liệu này về màn hình Tính Giá" Cursor="Hand"/>

                                            <Button Content="🗑️ Xóa" 
                                                    Command="{Binding DataContext.DeleteQuoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" 
                                                    Background="#dc3545" Foreground="White" Padding="8,4" Cursor="Hand"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>