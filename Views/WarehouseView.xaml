<Window x:Class="PhanMemInAnERP.Views.WarehouseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhanMemInAnERP.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:PhanMemInAnERP.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WarehouseViewModel, IsDesignTimeCreatable=False}"
        Title="Quản Lý Kho &amp; Vật Tư" Height="800" Width="1200" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:LoaiPhieuBackgroundConverter x:Key="LoaiPhieuBackgroundConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <TabControl Background="White" BorderBrush="#e0e0e0">

            <TabItem Header="🏷️ Danh Mục Vật Tư" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Thêm Vật Tư Mới" Foreground="#667eea" Margin="0,0,0,15">
                        <Grid Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Mã VT (*):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentMaterial.Code}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Column="2" Text="Tên VT (*):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Text="{Binding CurrentMaterial.Name}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Column="4" Text="ĐVT:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="5" Text="{Binding CurrentMaterial.Unit}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Column="6" Text="Loại:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="7" Text="{Binding CurrentMaterial.Category}" Padding="5">
                                <ComboBoxItem Content="Giấy"/>
                                <ComboBoxItem Content="Mực in"/>
                                <ComboBoxItem Content="Phụ liệu"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Tồn tối thiểu:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentMaterial.MinStock}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Ghi chú:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding CurrentMaterial.Notes}" Margin="0,0,15,0" Padding="5"/>

                            <Button Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2" Content="➕ Lưu VT" Command="{Binding SaveMaterialCommand}" Background="#17a2b8" Foreground="White" FontWeight="Bold"/>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Materials}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã VT" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Tên Vật Tư" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Tồn Tối Thiểu" Binding="{Binding MinStock}" Width="100"/>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding LastMovementTime, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=-}" Width="130"/>
                            <DataGridTemplateColumn Header="Xóa" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Command="{Binding DataContext.DeleteMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#dc3545" Foreground="White" Padding="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📥 Nhập Kho" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Lập Phiếu Nhập" Foreground="#28a745" Margin="0,0,0,15">
                        <Grid Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Số phiếu (*):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ImpTicketNo}" IsReadOnly="True" Background="#f0f0f0" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Column="2" Text="Ngày nhập:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ImpDate}" Margin="0,0,15,0"/>

                            <TextBlock Grid.Column="4" Text="Nhà Cung Cấp:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="5" ItemsSource="{Binding KnownSuppliers}"
                                      SelectedItem="{Binding ImpSupplier, Mode=TwoWay}"
                                      Text="{Binding ImpSupplier, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Padding="5" VerticalContentAlignment="Center"
                                      MinHeight="28" ToolTip="Chọn NCC đã dùng hoặc gõ tên mới"/>

                            <TextBlock Grid.Row="1" Text="Chọn VT:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,15,0" Padding="5"
                                      ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedItem="{Binding ImpSelectedMaterial}"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Ghi chú:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding ImpNotes}" Padding="5"/>

                            <TextBlock Grid.Row="2" Text="Số lượng (*):" VerticalAlignment="Center" Foreground="Blue"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImpQuantity, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Đơn giá (*):" VerticalAlignment="Center" Foreground="Blue"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ImpPrice, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,0,15,0" Padding="5"/>

                            <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="THÀNH TIỀN: " VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ImpTotal, StringFormat={}{0:N0} VNĐ}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#dc3545" Width="150"/>
                                <Button Content="💾 Lưu Phiếu" Command="{Binding SaveImportCommand}" Background="#28a745" Foreground="White" Width="100"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ImportList}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số Phiếu" Binding="{Binding TicketNo}"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding ImportDate, StringFormat=dd/MM/yyyy}"/>
                            <DataGridTextColumn Header="Tên Vật Tư" Binding="{Binding Material.Name}" Width="*"/>
                            <DataGridTextColumn Header="NCC" Binding="{Binding Supplier}" Width="150"/>
                            <DataGridTextColumn Header="SL Nhập" Binding="{Binding Quantity}"/>
                            <DataGridTextColumn Header="Đơn Giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"/>
                            <DataGridTemplateColumn Header="Xóa" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Command="{Binding DataContext.DeleteImportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#dc3545" Foreground="White" BorderThickness="0" Padding="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📤 Xuất Kho" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ===== PHẦN CHỌN BÁO GIÁ ĐỂ XUẤT KHO ===== -->
                    <Border Grid.Row="0" Background="#e8f5e9" BorderBrush="#4caf50" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="📋 XUẤT KHO TỪ BÁO GIÁ" FontWeight="Bold" Foreground="#2e7d32" Margin="0,0,0,10"/>
                            <TextBlock Text="Chọn báo giá để tự động tải thông tin vật tư cần xuất" FontStyle="Italic" Foreground="#666" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chọn Báo Giá:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableQuotations}" 
                                          SelectedItem="{Binding ExpSelectedQuotation}" 
                                          Padding="5" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding CustomerName}" FontWeight="Bold"/> 
                                                <Run Text=" - "/> 
                                                <Run Text="{Binding ProductName}"/> 
                                                <Run Text=" ("/>
                                                <Run Text="{Binding QuoteDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="📥 Tải Vật Tư" 
                                        Command="{Binding ImportFromQuotationCommand}" 
                                        CommandParameter="{Binding ExpSelectedQuotation}"
                                        Background="#4caf50" Foreground="White" Padding="15,5" FontWeight="Bold"/>
                            </Grid>

                            <!-- Danh sách vật tư từ báo giá -->
                            <DataGrid ItemsSource="{Binding QuotationMaterials}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" IsReadOnly="True" RowHeight="35" Margin="0,10,0,0"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Vật Tư" Binding="{Binding MaterialName}" Width="*"/>
                                    <DataGridTextColumn Header="Thông Tin" Binding="{Binding MaterialInfo}" Width="150"/>
                                    <DataGridTextColumn Header="Cần Xuất" Binding="{Binding RequiredQuantity, StringFormat={}{0:N0}}" Width="100"/>
                                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60"/>
                                    <DataGridTextColumn Header="Tồn Kho" Binding="{Binding AvailableStock, StringFormat={}{0:N0}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Header="Lập Phiếu Xuất" Foreground="#dc3545" Margin="0,0,0,15">
                        <Grid Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Số phiếu (*):" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ExpTicketNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0" Padding="5" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="Ngày xuất:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding ExpDate}" Margin="0,0,15,0"/>

                            <TextBlock Grid.Column="4" Text="Mục đích:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="5" Text="{Binding ExpPurpose, UpdateSourceTrigger=PropertyChanged}" Padding="5">
                                <ComboBoxItem Content="Sản xuất"/>
                                <ComboBoxItem Content="Bán hàng"/>
                                <ComboBoxItem Content="Khác"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Chọn VT:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,15,0" Padding="5"
                  ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedItem="{Binding ExpSelectedMaterial}"/>

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Thuộc Lệnh:" VerticalAlignment="Center" Foreground="#e67e22" FontWeight="Bold"/>
                            <ComboBox Grid.Row="1" Grid.Column="5" Padding="5"
                  ItemsSource="{Binding PendingProductionOrders}" 
                  SelectedItem="{Binding ExpSelectedProductionOrder}" 
                  DisplayMemberPath="OrderNo" materialDesign:HintAssist.Hint="Chọn Lệnh (nếu có)"/>

                            <TextBlock Grid.Row="2" Text="Số lượng (*):" VerticalAlignment="Center" Foreground="Blue"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ExpQuantity}" Margin="0,0,15,0" Padding="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Ghi chú:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExpNotes}" Margin="0,0,15,0" Padding="5"/>

                            <Button Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Content="💾 Lưu Phiếu &amp; Trừ Kho" Command="{Binding SaveExportCommand}" Background="#dc3545" Foreground="White" HorizontalAlignment="Right" Width="180"/>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ExportList}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số Phiếu" Binding="{Binding TicketNo}"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding ExportDate, StringFormat=dd/MM/yyyy}"/>
                            <DataGridTextColumn Header="Tên Vật Tư" Binding="{Binding Material.Name}" Width="*"/>
                            <DataGridTextColumn Header="Mục Đích" Binding="{Binding Purpose}" Width="150"/>
                            <DataGridTextColumn Header="SL Xuất" Binding="{Binding Quantity}"/>
                            <DataGridTemplateColumn Header="Thao tác" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="🖨️ In Phiếu"
                                                    Command="{Binding DataContext.ExportExcelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Background="#17a2b8" Foreground="White" Padding="5,2" Margin="0,0,6,0"/>
                                            <Button Content="🗑️ Xóa"
                                                    Command="{Binding DataContext.DeleteExportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Background="#dc3545" Foreground="White" Padding="5,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🏭 Nhập Kho Sản Xuất" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#fff3cd" BorderBrush="#ffc107" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DANH SÁCH SẢN PHẨM HOÀN THÀNH" FontWeight="Bold" Foreground="#856404" FontSize="16"/>
                            <TextBlock Text="Sản phẩm sau khi hoàn thành (HTXS) sẽ xuất hiện ở đây. Chọn sản phẩm để xuất kho bán hàng." FontSize="12" Foreground="#666" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProductionImports}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#f8f9fa">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Đã xuất">
                                        <Setter Property="Background" Value="#e8f5e9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Chưa xuất">
                                        <Setter Property="Background" Value="#fff3cd"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số Phiếu" Binding="{Binding TicketNo}" Width="130"/>
                            <DataGridTextColumn Header="Ngày Nhập" Binding="{Binding ImportDate, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Số Lệnh SX" Binding="{Binding ProductionOrder.OrderNo}" Width="120"/>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="200"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="150"/>
                            <DataGridTextColumn Header="Số Lượng" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Đã xuất">
                                                <Setter Property="Foreground" Value="#28a745"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Chưa xuất">
                                                <Setter Property="Foreground" Value="#dc3545"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Thao tác" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📤 Xuất bán hàng"
                                                    Command="{Binding DataContext.ExportProductionToSalesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#ff9800" Foreground="White" Padding="8,3">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Chưa xuất">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🏪 Xuất Bán Hàng / Phiếu Bàn Giao" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#fff8e1" BorderBrush="#ff9800" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Phiếu bàn giao — dùng khi đã sản xuất xong và giao thành phẩm cho khách (giống phiếu tiệm tạp hóa)." FontWeight="SemiBold" Foreground="#e65100" TextWrapping="Wrap"/>
                            <TextBlock Text="Chọn lệnh sản xuất → In phiếu: ghi loại giấy, khổ in, kích thước, công đoạn… và chỗ ký xác nhận của người nhận hàng. Việc trừ kho vật tư vẫn làm ở tab «Xuất Kho» (mục đích Bán hàng) nếu cần." FontSize="12" Foreground="#5d4037" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Header="Lập phiếu" Foreground="#e65100" Margin="0,0,0,12">
                        <Grid Margin="10" TextElement.Foreground="Black" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Lệnh SX (*):" VerticalAlignment="Center" FontWeight="Bold"/>
                            <ComboBox Grid.Column="1" Margin="0,0,16,0" Padding="6" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding HandoverProductionOrders}"
                                      SelectedItem="{Binding SelectedHandoverPo}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding OrderNo}" FontWeight="Bold"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding CustomerName}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding ProductName}"/>
                                            <Run Text=" | TT: "/>
                                            <Run Text="{Binding Status}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="Số phiếu:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Text="{Binding HandoverPhieuSo, UpdateSourceTrigger=PropertyChanged}" Padding="6" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <TextBlock Grid.Row="1" Text="Ngày lập:" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding HandoverNgayLap}" Margin="0,0,16,0" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Người giao:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HandoverNguoiBanGiao, UpdateSourceTrigger=PropertyChanged}" Padding="6" VerticalAlignment="Center" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="Họ tên nhân viên giao hàng"/>

                            <Button Grid.Column="4" Grid.RowSpan="2" Content="🖨️ In phiếu bàn giao" Command="{Binding PrintHandoverCommand}"
                                    Background="#ff9800" Foreground="White" Padding="15,5" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="180"/>
                        </Grid>
                    </GroupBox>

                    <Border Grid.Row="2" Background="#fafafa" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="4" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Gợi ý nội dung sẽ in (theo lệnh đã chọn)" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12">
                                    • Tham chiếu đơn hàng, lệnh SX, số hóa đơn (nếu có).<LineBreak/>
                                    • Loại giấy / GSM từ báo giá liên kết đơn hàng.<LineBreak/>
                                    • Kích thước sản phẩm, khổ in, con/tờ, bù hao.<LineBreak/>
                                    • Danh sách công đoạn đã chọn trên lệnh SX.<LineBreak/>
                                    • Hai ô ký: người giao hàng và người nhận hàng.
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="📦 Báo Cáo Tồn Kho" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15" Height="100">
                        <Border Background="#667eea" CornerRadius="8" Margin="5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="TỔNG LOẠI VẬT TƯ" Foreground="White" Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalMaterialTypes}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#28a745" CornerRadius="8" Margin="5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="GIÁ TRỊ TỒN KHO" Foreground="White" Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalInventoryValue, StringFormat={}{0:N0} đ}" FontSize="28" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#dc3545" CornerRadius="8" Margin="5" Padding="15">
                            <StackPanel>
                                <TextBlock Text="VẬT TƯ CẢNH BÁO" Foreground="White" Opacity="0.9"/>
                                <TextBlock Text="{Binding LowStockCount}" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="InvReportSearchCombo"
                                  MinWidth="400" MaxWidth="560"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  materialDesign:HintAssist.Hint="Gõ hoặc chọn mã / tên vật tư"
                                  ItemsSource="{Binding InventoryReportSearchHints}"
                                  Text="{Binding InventoryReportSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="InvReportSearchCombo_SelectionChanged"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding InventoryReports}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40" AlternatingRowBackground="#f8f9fa">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Background" Value="#FFF1F0"/>
                                        <Setter Property="ToolTip" Value="Cảnh báo: Vật tư này đã dưới mức tồn tối thiểu!"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="⚠️" Foreground="#dc3545" 
                                                   Visibility="{Binding IsLowStock, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Mã VT" Binding="{Binding MaterialCode}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tên Vật Tư" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding LastMovementTime, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=-}" Width="130"/>
                            <DataGridTextColumn Header="TỒN HIỆN TẠI" Binding="{Binding CurrentStock}" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Đơn Giá TB" Binding="{Binding AvgPrice, StringFormat={}{0:N0}}"/>
                            <DataGridTextColumn Header="Thành Tiền" Binding="{Binding TotalValue, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📋 Sổ Chi Tiết Vật Tư" FontSize="15" FontWeight="Bold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- PHẦN LỌC VÀ TÌM KIẾM -->
                    <Border Grid.Row="0" Background="#e8f4f8" BorderBrush="#4a90d9" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding SCTuNgay}" Margin="0,0,15,0" Padding="5" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                            <DatePicker Grid.Column="3" SelectedDate="{Binding SCDenNgay}" Margin="0,0,15,0" Padding="5" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4" Text="Vật tư:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                            <ComboBox Grid.Column="5"
                                      ItemsSource="{Binding SCMaterialHints}"
                                      IsEditable="True"
                                      materialDesign:HintAssist.Hint="Chọn hoặc gõ mã/tên vật tư"
                                      Padding="5" VerticalAlignment="Center" Margin="0,0,10,0"
                                      SelectionChanged="SCMaterialCombo_SelectionChanged"/>

                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button Content="🔍 Tìm kiếm" Command="{Binding SCTimKiemCommand}" Background="#4a90d9" Foreground="White" Padding="12,6" FontWeight="Bold" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Xóa lọc" Command="{Binding SCClearFilterCommand}" Background="#6c757d" Foreground="White" Padding="12,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TỔNG HỢP -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                        <Border Background="#667eea" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TỒN ĐẦU KỲ" Foreground="White" Opacity="0.9" FontSize="12"/>
                                <TextBlock Text="{Binding SCTonDauKy, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#28a745" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TỔNG NHẬP" Foreground="White" Opacity="0.9" FontSize="12"/>
                                <TextBlock Text="{Binding SCTongNhap, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#dc3545" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TỔNG XUẤT" Foreground="White" Opacity="0.9" FontSize="12"/>
                                <TextBlock Text="{Binding SCTongXuat, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#17a2b8" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel>
                                <TextBlock Text="TỒN CUỐI KỲ" Foreground="White" Opacity="0.9" FontSize="12"/>
                                <TextBlock Text="{Binding SCTonCuoiKy, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- BẢNG CHI TIẾT -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SoChiTietItems}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35" AlternatingRowBackground="#f8f9fa" CanUserSortColumns="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoaiPhieu}" Value="NHẬP">
                                        <Setter Property="Background" Value="#e8f5e9"/>
                                        <Setter Property="Foreground" Value="#2e7d32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LoaiPhieu}" Value="XUẤT">
                                        <Setter Property="Background" Value="#ffebee"/>
                                        <Setter Property="Foreground" Value="#c62828"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Ngay, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Số Phiếu" Binding="{Binding SoPhieu}" Width="120"/>
                            <DataGridTemplateColumn Header="Loại" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding LoaiPhieu, Converter={StaticResource LoaiPhieuBackgroundConverter}}" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding LoaiPhieu}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mã VT" Binding="{Binding MaVatTu}" Width="80"/>
                            <DataGridTextColumn Header="Tên Vật Tư" Binding="{Binding TenVatTu}" Width="*"/>
                            <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="60"/>
                            <DataGridTextColumn Header="Tồn ĐK" Binding="{Binding TonDauKy, StringFormat={}{0:N2}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SL Nhập" Binding="{Binding SoLuongNhap, StringFormat={}{0:N2}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#2e7d32"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SL Xuất" Binding="{Binding SoLuongXuat, StringFormat={}{0:N2}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#c62828"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tồn CK" Binding="{Binding TonCuoiKy, StringFormat={}{0:N2}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- NÚT XUẤT EXCEL -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="📥 Xuất Excel" Command="{Binding SCXuatExcelCommand}" Background="#28a745" Foreground="White" Padding="20,10" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>