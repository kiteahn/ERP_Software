<Window x:Class="PhanMemInAnERP.Views.AccountingToolsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kế toán tự động — Ánh xạ &amp; xem trước bút toán" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Mở tài liệu ánh xạ (HTML)" Padding="12,6" Click="OpenDoc_Click" Margin="0,0,12,0"/>
            <TextBlock VerticalAlignment="Center" Foreground="#666" TextWrapping="Wrap"
                       Text="PHẦN 3: mỗi nghiệp vụ sinh bút toán; dùng vùng dưới để thử xem trước trước khi ghi sổ."/>
        </StackPanel>
        <GroupBox Grid.Row="1" Header="Thử tạo bút toán (nhập số tiền VNĐ)" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Nghiệp vụ"/>
                <ComboBox x:Name="cbTrigger" Grid.Row="0" Grid.Column="1" Margin="8,4" DisplayMemberPath="Display" SelectedValuePath="Trigger"/>
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Amount — chính (NVL, DT chưa thuế, KH máy…)"/>
                <TextBox x:Name="tbAmount" Grid.Row="1" Grid.Column="1" Margin="8,4" Text="10000000"/>
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="VAT / Điện (Phân bổ máy: cột điện)"/>
                <TextBox x:Name="tbVat" Grid.Row="2" Grid.Column="1" Margin="8,4" Text="0"/>
                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="COGS / Giá vốn / Nhập lại kho"/>
                <TextBox x:Name="tbCogs" Grid.Row="3" Grid.Column="1" Margin="8,4" Text="0"/>
                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Chiết khấu / phụ"/>
                <TextBox x:Name="tbDiscount" Grid.Row="4" Grid.Column="1" Margin="8,4" Text="0"/>
                <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Diễn giải / số chứng từ"/>
                <TextBox x:Name="tbNote" Grid.Row="5" Grid.Column="1" Margin="8,4" Text=""/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="8,8,0,0">
                    <Button Content="Xem trước bút toán" Padding="16,8" Click="Preview_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Bảng ánh xạ nghiệp vụ → hạch toán (tham chiếu)" Padding="8">
            <DataGrid x:Name="gridMap" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False"/>
        </GroupBox>
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                   Text="Ghi chú: Phân bổ chi phí máy — Amount = khấu hao (→ Có 214), VAT = điện (→ Có 331), COGS = chi phí chung phải trả (→ Có 331). Liên kết giá thành PHẦN 2: NVL 621, NC 622, SC 627 tập hợp vào 154 trước khi Nợ 155 / Có 154."/>
    </Grid>
</Window>
