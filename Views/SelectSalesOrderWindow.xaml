<Window x:Class="PhanMemInAnERP.Views.SelectSalesOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Đơn Hàng Bán Hàng" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Chọn đơn hàng bán hàng để xuất kho sản phẩm hoàn thành" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SalesOrders}" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True" RowHeight="35" SelectionMode="Single"
                  SelectedItem="{Binding SelectedSalesOrder, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số ĐH" Binding="{Binding OrderNo}" Width="120"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="200"/>
                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat={}{0:N0}}" Width="80"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="❌ Hủy" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="✅ Chọn" Width="100" Background="#28a745" Foreground="White" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>
