<Window x:Class="PhanMemInAnERP.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đổi mật khẩu"
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="LockReset" Width="48" Height="48" 
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Đổi mật khẩu" 
                       FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            <TextBlock x:Name="txtThongBao" 
                       Text="Bạn phải đổi mật khẩu trước khi sử dụng hệ thống"
                       FontSize="12" 
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Mật khẩu cũ -->
        <StackPanel Grid.Row="2" x:Name="lblOldPassword">
            <TextBlock Text="Mật khẩu cũ" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtOldPassword"
                         materialDesign:HintAssist.Hint="Nhập mật khẩu cũ"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
        </StackPanel>

        <!-- Mật khẩu mới -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Mật khẩu mới" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtNewPassword"
                         materialDesign:HintAssist.Hint="Nhập mật khẩu mới (tối thiểu 6 ký tự)"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
        </StackPanel>

        <!-- Xác nhận mật khẩu -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Xác nhận mật khẩu mới" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmPassword"
                         materialDesign:HintAssist.Hint="Nhập lại mật khẩu mới"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnHuy"
                    Content="HỦY"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,10,0"
                    Width="100"
                    Click="BtnHuy_Click"/>
            <Button x:Name="btnDoiMatKhau"
                    Content="ĐỔI MẬT KHẨU"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="150"
                    Click="BtnDoiMatKhau_Click"/>
        </StackPanel>
    </Grid>
</Window>
