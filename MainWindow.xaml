<Window x:Class="PhanMemInAnERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VIỆT TIẾN ERP - HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP IN ẤN" 
        Height="650" Width="1100" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F2F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2c3e50" Offset="0"/>
                    <GradientStop Color="#000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="HỆ THỐNG QUẢN TRỊ IN ẤN &amp; BAO BÌ" Foreground="White" FontSize="32" FontWeight="Bold" />
             
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="40,24,40,24"
                      Background="Transparent">
            <WrapPanel HorizontalAlignment="Center">

            <Button x:Name="btnQuotation" Click="OpenQuotation" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="TÍNH GIÁ &amp; BÁO GIÁ" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                                <TextBlock Text="Tính toán giá vốn, lợi nhuận, in ấn" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnProduction" Click="OpenProduction" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="LỆNH SẢN XUẤT" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                                <TextBlock Text="Quản lý tiến độ xưởng in" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnWarehouse" Click="OpenWarehouse" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="KHO &amp; VẬT TƯ" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                                <TextBlock Text="Nhập, xuất, tồn kho giấy, mực" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnSales" Click="OpenSales" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="THANH TOÁN &amp; HÓA ĐƠN" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                                <TextBlock Text="Theo dõi đơn hàng, hóa đơn, nợ KH" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Click="OpenHistory" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="LỊCH SỬ &amp; THỐNG KÊ" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#2c3e50"/>
                                <TextBlock Text="Biểu đồ doanh thu, xem lại báo giá" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnCustomers" Click="OpenCustomers" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#fff8f0" CornerRadius="15" BorderBrush="#e65100" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="KHÁCH HÀNG" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#e65100"/>
                                <TextBlock Text="Danh bạ, MST, địa chỉ giao hàng" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnAccounting" Click="OpenAccountingTools" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#f3e8ff" CornerRadius="15" BorderBrush="#9333ea" BorderThickness="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="📒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="KẾ TOÁN TỰ ĐỘNG" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#6b21a8"/>
                                <TextBlock Text="Ánh xạ nghiệp vụ, xem trước bút toán" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnAdminUser" Click="OpenAdminUser" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#e8f4f8" CornerRadius="15" BorderBrush="#17a2b8" BorderThickness="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="QUẢN LÝ TÀI KHOẢN" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#17a2b8"/>
                                <TextBlock Text="Phân quyền, cấp lại mật khẩu" FontSize="13" Foreground="#7f8c8d" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Click="ExitApp" Margin="15" Width="300" Height="150" Background="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#FFF1F0" CornerRadius="15" BorderBrush="#FFA39E" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="ĐĂNG XUẤT" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="#CF1322"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>